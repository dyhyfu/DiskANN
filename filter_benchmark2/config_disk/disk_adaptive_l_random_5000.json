{
  "search_directories": [
    "enron_filter_benchmark2/output",
    "filter_benchmark2"
  ],
  "jobs": [
    {
      "type": "disk-index-filter",
      "content": {
        "source": {
          "disk-index-source": "Load",
          "data_type": "float16",
          "load_path": "filter_benchmark2/disk_index_enron"
        },
        "search_phase": {
          "queries": "query_vector_normalized_dim_384_fp16_top_1000.bin",
          "groundtruth": "random_5000_groundtruth_filtered.bin",
          "data_labels": "data.label.jsonl",
          "query_predicates": "random_5000_query.label.jsonl",
          "search_list": [
            1000,
            2000,
            3000
          ],
          "beam_width": 4,
          "recall_at": 1000,
          "num_threads": 12,
          "distance": "squared_l2",
          "filter_type": {
            "type": "AdaptiveLGreedy"
          }
        }
      }
    }
  ]
}
